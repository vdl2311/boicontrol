      "title": "Transacao",
      "description": "Transação financeira da fazenda",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string" },
        "categoria": { "type": "string" },
        "descricao": { "type": "string" },
        "valor": { "type": "number" },
        "data": { "type": "string" },
        "animalId": { "type": "string" },
        "fazendaId": { "type": "string" },
        "observacoes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tipo", "categoria", "descricao", "valor", "fazendaId"]
    }
