      "properties": {
        "id": { "type": "string" },
        "femeaId": { "type": "string" },
        "touroId": { "type": "string" },
        "tipo": { "type": "string" },
        "dataMonta": { "type": "string" },
        "dataPrevistaParto": { "type": "string" },
        "dataParto": { "type": "string" },
        "status": { "type": "string" },
        "resultado": { "type": "string" },
        "observacoes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "femeaId", "tipo", "status"]
