    "alimentacao": {
      "title": "Alimentacao",
      "description": "Registro de alimentação ou trato nutricional",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "animalId": { "type": "string" },
        "lote": { "type": "string" },
        "tipoRacao": { "type": "string" },
        "quantidade": { "type": "number" },
        "custoUnitario": { "type": "number" },
