{
  "entities": {
    "fazenda": {
      "title": "Fazenda",
      "description": "Fazenda cadastrada",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "cidade": { "type": "string" },
        "estado": { "type": "string" },
        "areaTotal": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nome"]
    },
    "animal": {
      "title": "Animal",
      "description": "Animal/bovino cadastrado na fazenda",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "identificacao": { "type": "string" },
        "nome": { "type": "string" },
        "especie": { "type": "string" },
        "raca": { "type": "string" },
        "sexo": { "type": "string" },
        "dataNascimento": { "type": "string" },
        "pesoInicial": { "type": "number" },
        "pesoAtual": { "type": "number" },
        "status": { "type": "string" },
        "categoria": { "type": "string" },
        "cor": { "type": "string" },
        "fotoUrl": { "type": "string" },
        "observacoes": { "type": "string" },
        "origem": { "type": "string" },
        "dataEntrada": { "type": "string" },
        "paiId": { "type": "string" },
        "maeId": { "type": "string" },
        "fazendaId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "identificacao", "sexo", "categoria", "status", "fazendaId"]
    },
    "saude": {
      "title": "Saude",
      "description": "Registro de saúde e manejo sanitário",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "animalId": { "type": "string" },
        "tipo": { "type": "string" },
        "descricao": { "type": "string" },
        "produto": { "type": "string" },
