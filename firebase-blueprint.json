  "firestore": {
    "fazendas": {
      "schema": "fazenda",
      "description": "Collection of all farm entities"
    },
    "animais": {
      "schema": "animal",
      "description": "Collection of all animal entities"
    },
    "saudes": {
      "schema": "saude",
      "description": "Collection of all health records"
    },
    "pesagens": {
      "schema": "pesagem",
      "description": "Collection of all weight records"
    },
    "alimentacoes": {
      "schema": "alimentacao",
      "description": "Collection of all nutrition records"
    },
    "reproducoes": {
      "schema": "reproducao",
      "description": "Collection of all reproduction records"
    },
    "transacoes": {
      "schema": "transacao",
      "description": "Collection of all transaction records"
    }
  }
